# ==============================================================================
# useai.sh — Environment Configuration Template
# ==============================================================================
# ⚠️ SECURITY WARNING:
# Variables prefixed with VITE_ are bundled into public client-side JavaScript.
# NEVER place private backend API keys, database credentials, or secret tokens here.
# ==============================================================================

# Public deployment domain URL
VITE_APP_URL=https://useai.sh

# Open-source repository URL for GitHub links and contributor actions
VITE_GITHUB_REPO_URL=https://github.com/yourusername/useai.sh
